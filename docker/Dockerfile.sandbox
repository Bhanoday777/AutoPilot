# Autopilot sandbox: free official image + open-source tools only.
FROM python:3.11-slim

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ripgrep build-essential ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && pip install pytest

RUN useradd --uid 1000 --create-home --shell /bin/bash agent \
 && mkdir -p /workspace \
 && chown agent:agent /workspace

USER agent
ENV PATH="/home/agent/.local/bin:${PATH}"

RUN git config --global user.name "Autopilot Agent" \
 && git config --global user.email "autopilot-agent@users.noreply.github.com" \
 && git config --global core.autocrlf false \
 && git config --global init.defaultBranch main \
 && git config --global --add safe.directory '*'

WORKDIR /workspace
CMD ["sleep", "infinity"]
