# Autopilot configuration. Copy to .env and fill in at least ONE free key.
# All providers below are FREE and need no credit card.

# Order in which providers are tried (providers without a key are skipped).
PROVIDER_ORDER=gemini,groq,openrouter

# Google Gemini (AI Studio) - free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq - free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter - free key: https://openrouter.ai/keys
# The model MUST end in ":free" (Autopilot refuses to start otherwise).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# GitHub (free personal access token, used from Day 4): https://github.com/settings/tokens
GITHUB_TOKEN=

# Sandbox limits
SANDBOX_IMAGE=autopilot-sandbox:latest
SANDBOX_MEMORY=2g
SANDBOX_CPUS=2
SANDBOX_PIDS_LIMIT=512
